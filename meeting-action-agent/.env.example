# MeetingMind environment variables
# Copy this file to .env for local development if needed.

# LLM provider configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Deployment mode (local OpenClaw Agent + Selenium browser demo)
# local | cloud  — or use MEETINGMIND_APP_MODE=local|web
MEETINGMIND_DEPLOY_MODE=local
# MEETINGMIND_APP_MODE=web
